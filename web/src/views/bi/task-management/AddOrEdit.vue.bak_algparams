.return-button {
  font-size: 16px;
  font-weight: 500;

  :deep(.n-button__content) {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  :deep(.n-button__icon) {
    font-size: 18px;
  }

  &:hover {
    color: #409eff !important;
    background-color: rgba(64, 158, 255, 0.1);
    border-radius: 6px;
  }
}

:deep(.n-checkbox) {
  margin: 0;
  padding: 12px;
  border: 1px solid transparent;
  transition: all 0.2s;

  &.n-checkbox--checked {
    border-color: #0c5cffff;
    background-color: rgba(24, 56, 160, 0.1);
  }
}
</style>
